# Copy to .env and fill in. The stack starts even if the Telegram values are
# placeholders — only Telegram alert delivery will be inactive until they are set.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
# Must be numeric (Telegram chat id). Negative = group/supergroup.
TELEGRAM_CHAT_ID=-1000000000000
